/// Professional context based on a real ODRES Group experience. Public technical reconstruction using synthetic data.
model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

	annotation Disclosure = Synthetic data - not ODRES figures

ref table DimDate
ref table DimChannel
ref table DimCampaign
ref table DimRegion
ref table DimCustomer
ref table FactMarketingDaily
ref table FactLeads
ref table FactOpportunities
ref table FactCustomerMonthly
ref table DataQualityChecks
ref table DataQualityRowCounts
ref table CleaningLog
